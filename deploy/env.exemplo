# PixelFinance — modelo do .env de PRODUÇÃO (copie para .env na raiz do repositório no VPS).
# Só nomes e explicações: NUNCA ponha valores reais neste arquivo (ele vai pro git).
# DATABASE_URL não entra aqui: o docker-compose.yml monta a URL com POSTGRES_PASSWORD.

# ── banco ────────────────────────────────────────────────────────────────────
# só letras e números (vai dentro da URL do banco). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── login: SÓ pela Cloudflare Access (obrigatório — sem as duas ninguém entra e o deploy recusa) ──
# ex.: pixel.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
# o "Application Audience (AUD) Tag" do app no Zero Trust
ACCESS_AUD=

# ── arquivos no Cloudflare R2 (as 4 vazias = upload desligado, responde 503) ──
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── bancos ───────────────────────────────────────────────────────────────────
# Preferível: token por CONTA (tela Contas) ou credencial por EMPRESA (Integrações). As chaves
# globais abaixo só valem para o superadmin (a equipe nunca as usa — ver resolveBankToken).
MERCURY_API_TOKEN=
MERCURY_API_KEY=
MERCURY_API_KEY_4ADS=
WISE_API_BASE=
WISE_API_TOKEN=
WISE_API_KEY=
WISE_API_KEY_ACTIVEVIEW_LLC=
WISE_PROFILE_ID=
WISE_CLIENT_ID=
WISE_CLIENT_SECRET=
WISE_REDIRECT_URI=
REVOLUT_API_BASE=
# CONTEÚDO do PEM com \n (não use *_PATH: o container não tem o arquivo)
REVOLUT_PRIVATE_KEY=
REVOLUT_REDIRECT_URI=
REVOLUT_ACCESS_TOKEN=

# ── Meta ─────────────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_API_VERSION=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
